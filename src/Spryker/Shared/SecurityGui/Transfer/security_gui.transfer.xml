<?xml version="1.0"?>
<transfers xmlns="spryker:transfer-01" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="spryker:transfer-01 http://static.spryker.com/transfer-01.xsd">

    <transfer name="Message">
        <property name="value" type="string"/>
    </transfer>

    <transfer name="User">
        <property name="lastLogin" type="string"/>
        <property name="username" type="string"/>
        <property name="password" type="string"/>
        <property name="status" type="string"/>
    </transfer>

    <transfer name="OauthAuthenticationLink">
        <property name="href" type="string"/>
        <property name="target" type="string"/>
        <property name="text" type="string"/>
        <property name="template" type="string"/>
    </transfer>

    <transfer name="UserPasswordResetRequest">
        <property name="email" type="string"/>
    </transfer>

    <transfer name="UserCollection" strict="true">
        <property name="users" type="User[]" singular="user"/>
    </transfer>

    <transfer name="UserConditions" strict="true">
        <property name="usernames" type="string[]" singular="username"/>
        <property name="statuses" type="string[]" singular="status"/>
    </transfer>

    <transfer name="UserCriteria">
        <property name="userConditions" type="UserConditions" strict="true"/>
    </transfer>

    <transfer name="SecurityCheckAuthContext">
        <property name="type" type="string"/>
        <property name="ip" type="string"/>
        <property name="account" type="string"/>
    </transfer>

    <transfer name="SecurityCheckAuthResponse">
        <property name="isBlocked" type="bool"/>
        <property name="numberOfAttempts" type="int"/>
        <property name="blockedFor" type="int"/>
        <property name="securityCheckAuthContext" type="SecurityCheckAuthContext"/>
    </transfer>

    <transfer name="AuditLoggerConfigCriteria" strict="true">
        <property name="channelName" type="string"/>
    </transfer>

    <transfer name="MultiFactorAuthValidationResponse" strict="true">
        <property name="isRequired" type="bool"/>
        <property name="status" type="int"/>
    </transfer>

    <transfer name="MultiFactorAuthValidationRequest" strict="true">
        <property name="user" type="User"/>
        <property name="isLogin" type="bool"/>
    </transfer>

    <transfer name="MultiFactorAuth" strict="true">
        <property name="user" type="User"/>
    </transfer>

    <transfer name="GlueAuthenticationRequestContext">
        <property name="requestApplication" type="string" description="The application making the request."/>
    </transfer>

    <transfer name="OauthRequest">
        <property name="grantType" type="string" description="The method by which an application gets an access token (e.g., 'password', 'refresh_token')."/>
        <property name="username" type="string" description="The login name for a user account, typically an email address."/>
        <property name="password" type="string" description="The password for a user account, used for authentication."/>
        <property name="glueAuthenticationRequestContext" type="GlueAuthenticationRequestContext"/>
    </transfer>

    <transfer name="OauthResponse">
        <property name="isValid" type="bool" description="A boolean flag indicating if a token or request is valid."/>
        <property name="accessToken" type="string" description="The token used for authenticating API requests."/>
        <property name="refreshToken" type="string" description="A token used to obtain a new access token when the current one expires."/>
        <property name="expiresIn" type="int" description="The duration in seconds for which an access token is valid."/>
    </transfer>

</transfers>
